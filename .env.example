APP_NAME=Hamster
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Used by docker-compose.yml to provision the local Postgres container
POSTGRES_USER=hamster
POSTGRES_PASSWORD=hamster
POSTGRES_DB=hamster
POSTGRES_PORT=5432

# Point this at any Postgres instance (local Docker or a managed cloud DB)
DATABASE_URL=postgresql+psycopg2://hamster:hamster@localhost:5432/hamster

SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
